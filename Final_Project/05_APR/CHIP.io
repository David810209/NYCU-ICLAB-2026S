###############################################################
#  Edited IO order for CHIP
#  Policy: four real sides only; balanced pin count.
#  Total pins: 306 = 86 inputs + 220 outputs
#  Side counts: top=76, left=77, bottom=76, right=77
#  Placement intent:
#    left   : main input-response side, rst_n at the middle
#    bottom : remaining input pins placed first, near the left corner
#    top    : inst_1 read request + first part of inst_2 read request
#    right  : remaining inst_2 read request + write address/response, clk at the middle
###############################################################

(globals
    version = 3
    io_order = default
)
