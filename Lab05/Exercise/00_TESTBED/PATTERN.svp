// verilog_format: off
`ifdef RTL
  `define CYCLE_TIME 20.0
`endif
`ifdef GATE
  `define CYCLE_TIME 20.0
`endif

// verilog_format: off
module PATTERN (
    output logic       clk,
    output logic       rst_n,
    output logic       i_valid,
    output logic [2:0] i_iter,
    output logic [1:0] i_mode,
    output logic [7:0] i_data,
    output logic [3:0] i_weight,

    input  logic       o_valid,
    input  logic [7:0] o_data
);
  
