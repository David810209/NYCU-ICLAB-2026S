`define CYCLE_TIME      24.5

module PATTERN(
    // Output Port (To DUT)
    output reg          clk,
    output reg          rst_n,
    output reg          instruction_in_valid,
    output reg          image_in_valid,
    output reg          weight_in_valid,
    output reg  [31:0]  in_data,
    
    // Input Port (From DUT)
    input               out_valid,
    input       [31:0]  out_data
);


